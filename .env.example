PORT=8080
HOST=0.0.0.0
LAVALENS_TOKEN=troque-por-um-token-longo-e-aleatorio
NODE_ID=node-local-01
STATE_TTL_MS=1800000
EVENT_HISTORY=64
MAX_BODY_BYTES=524288
LOG_LEVEL=info

# YouTube: se estiver true, OAuth é obrigatório e o processo recusa iniciar sem credenciais.
YOUTUBE_ENABLED=true
YOUTUBE_OAUTH_REQUIRED=true
YOUTUBE_OAUTH_CREDENTIALS_FILE=./lavalens-oauth.json
YOUTUBE_MAX_PLAYLIST_TRACKS=100
YOUTUBE_CACHE_DIR=./.cache/youtube

# Áudio
FFMPEG_PATH=ffmpeg
AUDIO_PROFILE=balanced
AUDIO_BITRATE_KBPS=128
AUDIO_BUFFER_MS=500
MAX_ACTIVE_PLAYERS=2
MAX_QUEUE_SIZE=500

# Cloudflare/origem
PUBLIC_BASE_URL=http://localhost:8080
