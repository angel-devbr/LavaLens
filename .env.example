PORT=8080
HOST=0.0.0.0
LAVALENS_TOKEN=troque-por-um-token-longo-e-aleatorio
NODE_ID=node-local-01
STATE_TTL_MS=1800000
EVENT_HISTORY=64
MAX_BODY_BYTES=524288
LOG_LEVEL=info
# Anti-SSRF: por padrão o provider HTTP não acessa redes internas/metadados de nuvem.
# Ative apenas se você realmente precisa tocar fontes na rede local.
ALLOW_PRIVATE_NETWORK=false

# YouTube: se estiver true, OAuth é obrigatório e o processo recusa iniciar sem credenciais.
YOUTUBE_ENABLED=true
YOUTUBE_OAUTH_REQUIRED=true
YOUTUBE_OAUTH_CREDENTIALS_FILE=./lavalens-oauth.json
YOUTUBE_MAX_PLAYLIST_TRACKS=100
YOUTUBE_CACHE_DIR=./.cache/youtube
# Fallback SABR/UMP via googlevideo quando youtubei.js.download() não possui URL direta.
YOUTUBE_SABR_ENABLED=true
# Alguns clientes/IPs podem exigir Proof-of-Origin. Deixe vazio até o YouTube exigir.
YOUTUBE_PO_TOKEN=
YOUTUBE_SABR_AUDIO_QUALITY=AUDIO_QUALITY_MEDIUM
YOUTUBE_SABR_MAX_RETRIES=5
YOUTUBE_SABR_STALL_DETECTION_MS=20000
# Limite do interpretador do player; restringido a 100–15000 ms.
YOUTUBE_JS_EVAL_TIMEOUT_MS=5000

# Áudio
FFMPEG_PATH=ffmpeg
AUDIO_PROFILE=balanced
AUDIO_BITRATE_KBPS=128
AUDIO_BUFFER_MS=500
MAX_ACTIVE_PLAYERS=2
MAX_QUEUE_SIZE=500

# Cloudflare/origem
PUBLIC_BASE_URL=http://localhost:8080
